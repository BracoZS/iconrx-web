{
  "name": "astro-iconrx",
  "version": "0.1.0",
  "description": "Lightweight Astro icon integration: local SVGs, auto-download from Iconify in dev, 100% static in build.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./components": {
      "types": "./src/components.d.ts",
      "default": "./src/components.js"
    },
    "./svelte": {
      "types": "./src/Icon.svelte.d.ts",
      "svelte": "./src/Icon.svelte",
      "default": "./src/Icon.svelte"
    },
    "./core": "./src/core.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "astro-component",
    "icons",
    "svg",
    "iconify"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BracoZS/iconrx-web.git",
    "directory": "packages/astro-iconrx"
  },
  "homepage": "https://github.com/BracoZS/iconrx-web/tree/main/packages/astro-iconrx#readme",
  "bugs": {
    "url": "https://github.com/BracoZS/iconrx-web/issues"
  },
  "author": "BracoZS",
  "license": "MIT",
  "dependencies": {
    "iconrx": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "svelte": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
